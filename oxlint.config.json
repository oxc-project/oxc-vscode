{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "ignorePatterns": ["fixtures/**"],
  "rules": {
    "typescript/no-floating-promises": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
